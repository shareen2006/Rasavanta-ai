# RASAVANTA AI Backend Environment Configuration (Production & Development)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI
# Ensure 0.0.0.0/0 is whitelisted in MongoDB Atlas -> Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Secret for Session Signing
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Client Frontend URL for Email Verification Links & CORS
CLIENT_URL=https://rasavanta-ai.vercel.app
FRONTEND_URL=https://rasavanta-ai.vercel.app

# ==============================================================================
# EMAIL SERVICE CONFIGURATION (Multi-Provider: Gmail SMTP & Resend)
# ==============================================================================
# Active provider: 'gmail' (default) or 'resend'
EMAIL_PROVIDER=gmail

# Provider 1: Gmail SMTP (via Nodemailer with STARTTLS)
# Obtain a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rasavantaai@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
EMAIL_FROM=RASAVANTA AI <rasavantaai@gmail.com>

# Provider 2: Resend API (Alternative Provider)
# Obtain API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Optional YouTube Data API v3 (for on-demand tutorial video search)
# Falls back to curated masterclass tutorials and direct embeds when omitted
YOUTUBE_API_KEY=your_youtube_data_api_key_here
